# Copy to .env and fill in real values. Never commit .env.

# dev | prod  — "dev" enables development-only behaviour such as SUPER_OTP.
APP_MODE=prod

PORT=8080

# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Public origin of the frontend, used to build the data-deletion status URL that
# Meta's Data Deletion Request callback must return. Must be publicly reachable.
APP_PUBLIC_URL=http://localhost:3000

MONGO_URI=
# Use a long random string, not a JWT. e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=1d

EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

GROQ_API_KEY=
SENTRY_DSN=

# Development-only OTP bypass. Ignored unless APP_MODE is dev/development/local/test.
# Leave empty in every shared environment.
SUPER_OTP=

# Plan changes and paid upgrades. Keep false until billing runs on verified webhooks.
BILLING_ENABLED=false

# --- Application-level encryption -------------------------------------------
# 32 bytes, base64 each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store in the secret manager and back up outside the database — without these
# the encrypted data is unrecoverable.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_KEYS_RETIRED=
BLIND_INDEX_KEY=

# Local debugging escape hatch only. Never false in a shared environment.
ENCRYPTION_ENABLED=true
# Keep true until scripts/encryptExistingData.js has run and been verified.
ENCRYPTION_DUAL_READ=true
